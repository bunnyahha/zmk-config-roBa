#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";
        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };
        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };
        muhenkan {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };
        double_quote {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };
        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

mkp_exit_AML: mkp_exit_AML {
compatible = "zmk,behavior-macro-one-param";
#binding-cells = <1>;
bindings =
<&macro_press>,
<&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
<&macro_pause_for_release>,
<&macro_release>,
<&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
<&macro_tap>,
<&sl 4>;
label = "MKP_EXIT_AML";
};

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ------------------------------------------------------------------------------------------------------
        // LAYER 0: Default
        // Screenshot 1 positions:
        // LH Inner: ESC, TAB
        // RH Inner: EQUAL, LPAR (Parenthesis)
        // LH Thumb: INT_MUHENKAN(L6), SPACE(L2)
        // RH Thumb: INT_HENKAN(L1), BACKSPACE
        // P Key: &lt 5 P
        // ------------------------------------------------------------------------------------------------------
        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R                        &kp T                                                                     &kp Y        &kp U  &kp I      &kp O    &lt 5 P
&kp A             &kp S         &kp D         &kp F                        &kp G        &kp ESC                           &kp EQUAL                  &kp H        &kp J  &kp K      &kp L    &kp MINUS
&mt LSHFT Z       &kp X         &kp C         &kp V                        &kp B        &kp TAB                           &kp LPAR                   &kp N        &kp M  &kp COMMA  &kp DOT  &mt RSHFT SLASH
&kp LCTRL         &kp LWIN      &kp LALT      &lt 6 INT_MUHENKAN           &lt 2 SPACE                                                               &lt 1 INT_HENKAN    &kp BSPC            &kp DEL
            >;
            sensor-bindings = <&scroll_up_down>;
        };

        // ------------------------------------------------------------------------------------------------------
        // LAYER 1: Symbols
        // Screenshot 2 positions:
        // LH: & * ( ) | ~ $ % ^ | ! @ #
        // RH: ( ) { } , ' \ | [ ] : " |
        // ------------------------------------------------------------------------------------------------------
        SYMBOL {
            bindings = <
&trans     &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR                                                 &trans     &trans     &trans     &trans    &trans
&kp TILDE  &kp DLLR   &kp PRCNT  &kp CARET  &trans     &trans                         &trans         &kp LBRC   &kp RBRC   &kp COMMA  &kp SQT   &kp BSLH
&trans     &kp EXCL   &kp AT     &kp HASH   &trans     &trans                         &trans         &kp LBKT   &kp RBKT   &kp COLON  &kp DQT   &kp PIPE
&trans     &trans     &trans     &trans     &trans                                                   &trans     &trans                          &trans
            >;
        };

        // ------------------------------------------------------------------------------------------------------
        // LAYER 2: Num
        // Screenshot 3 positions:
        // LH: - 7 8 9 + | / 4 5 6 * | mt(Shift,0) 1 2 3 .
        // LH Inner: EQUAL (top), LALT+KP_N0 (bot)
        // RH: F7 F8 F9 F10 | F4 F5 F6 F11 | F1 F2 F3 F12
        // RH Inner: ESC (top)
        // ------------------------------------------------------------------------------------------------------
        NUM {
            bindings = <
&kp MINUS          &kp N7     &kp N8     &kp N9     &kp PLUS                                                      &trans     &kp F7     &kp F8     &kp F9    &kp F10
&kp SLASH          &kp N4     &kp N5     &kp N6     &kp ASTRK  &kp EQUAL                       &kp ESC            &trans     &kp F4     &kp F5     &kp F6    &kp F11
&mt LSHFT KP_N0    &kp N1     &kp N2     &kp N3     &kp DOT    &kp LS(LA(KP_N0))               &trans             &trans     &kp F1     &kp F2     &kp F3    &kp F12
&trans             &trans     &trans     &trans     &trans                                                        &trans     &trans                          &kp F13
            >;
        };

        // ------------------------------------------------------------------------------------------------------
        // LAYER 3: Arrow
        // Screenshot 4 positions (Mirrored Nav):
        // LH: Win+Left, S+Tab, Up, C+Tab, Win+Right | Home, Left, Down, Right, End | ...
        // RH: Win+Left, S+Tab, Up, Tab, Win+Right | Home, Left, Down, Right, End | ...
        // ------------------------------------------------------------------------------------------------------
        ARROW {
            bindings = <
&kp LG(LEFT) &kp LS(TAB)    &kp UP     &kp LC(TAB)    &kp LG(RIGHT)                                               &kp LG(LEFT) &kp LS(TAB) &kp UP     &kp TAB     &kp LG(RIGHT)
&kp HOME     &kp LEFT       &kp DOWN   &kp RIGHT      &kp END      &trans                         &trans              &kp HOME     &kp LEFT    &kp DOWN   &kp RIGHT   &kp END
&trans       &kp LG(LEFT)   &trans     &trans         &trans       &trans                         &trans              &trans       &kp LG(LEFT) &trans    &kp LG(RIGHT) &trans
&trans       &trans         &trans     &trans         &trans                                                          &trans       &trans                             &trans
            >;
        };

        // ------------------------------------------------------------------------------------------------------
        // LAYER 4: Mouse (Preserved from template)
        // ------------------------------------------------------------------------------------------------------
        MOUSE {
            bindings = <
&trans     &trans     &trans     &trans     &trans                                                   &trans     &trans     &trans     &trans    &trans
&trans     &trans     &trans     &trans     &trans     &trans                       &trans           &trans     &mkp MB1   &trans     &mkp MB2  &trans
&trans     &trans     &trans     &trans     &trans     &trans                       &trans           &trans     &trans     &trans     &trans    &trans
&trans     &trans     &trans     &trans     &trans     &trans                       &trans           &trans                                     &trans
            >;
        };

        // ------------------------------------------------------------------------------------------------------
        // LAYER 5: Scroll (Activated by holding P)
        // ------------------------------------------------------------------------------------------------------
        SCROLL {
            bindings = <
&trans     &trans     &trans     &trans     &trans                                                   &trans     &trans     &trans     &trans    &trans
&trans     &trans     &trans     &trans     &trans     &trans                       &trans           &trans     &trans     &trans     &trans    &trans
&trans     &trans     &trans     &trans     &trans     &trans                       &trans           &trans     &trans     &trans     &trans    &trans
&trans     &trans     &trans     &trans     &trans     &trans                       &trans           &trans                                     &trans
            >;
        };

        // ------------------------------------------------------------------------------------------------------
        // LAYER 6: Settings
        // ------------------------------------------------------------------------------------------------------
        layer_6 {
            bindings = <
&trans           &trans           &trans           &trans           &trans                                                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans           &trans           &trans           &trans           &trans     &trans                       &trans                   &trans        &trans        &trans        &trans        &trans
&trans           &kp N1           &kp N2           &kp N3           &trans     &trans                       &bootloader              &trans        &trans        &trans        &trans        &bt BT_CLR
&trans           &trans           &trans           &trans           &trans     &trans                       &trans                   &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
